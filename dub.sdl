name "notorious"
description "Cross-platform sticky notes + notepad hybrid (D + dui/dew)"
authors "amdphreak"
copyright "Copyright © 2026, AMDphreak"
license "BSL-1.0"
version "0.1.1"

dependency "dui" path="../../dlang-supplemental/dui"
dependency "dew" path="../../dlang-supplemental/dew"
dependency "tgc" version="~>0.1.1"

targetType "executable"
targetName "notorious"
mainSourceFile "source/app.d"
sourcePaths "source"
importPaths "source"
stringImportPaths "."

configuration "application" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "DewHeadless"
}

configuration "windowed" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "NotoriousWindowed"
	subConfiguration "dew" "gpu"
	dependency "glfw-d" version="~>1.1.2"
	# Direct dep so vello-d's lflags/libs (vello_bridge staticlib) apply to this exe link.
	dependency "vello-d" path="../../dlang-supplemental/vello-d"
	# GUI launch must not allocate a console (headless/unittest stay CUI).
	platform "windows" {
		lflags "/SUBSYSTEM:WINDOWS"
	}
}

configuration "unittest" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "DewHeadless" "NotoriousTest"
}
