name "notorious"
description "Cross-platform sticky notes + notepad hybrid (D + dui/dew)"
authors "amdphreak"
copyright "Copyright © 2026, AMDphreak"
license "BSL-1.0"
version "0.1.1"

dependency "dui" path="../../dlang-supplemental/dui"
dependency "dew" path="../../dlang-supplemental/dew"
dependency "tgc" version="~>0.1.1"

targetType "executable"
targetName "notorious"
mainSourceFile "source/app.d"
sourcePaths "source"
importPaths "source"
stringImportPaths "."

configuration "application" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "DewHeadless"
}

configuration "windowed" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "NotoriousWindowed"
	subConfiguration "dew" "gpu"
	dependency "glfw-d" path="../../dlang-supplemental/glfw-d"
	dependency "vello-d" path="../../dlang-supplemental/vello-d"
	# VELLO_BRIDGE_DIR must be an absolute path to vello_bridge/target/release
	# (CI sets it). LDC passes lflags as -L<flag>, so bare .lib paths are not inputs —
	# use libs + /LIBPATH (or -L) instead.
	platform "windows" {
		lflags "/SUBSYSTEM:WINDOWS"
		lflags "/LIBPATH:$VELLO_BRIDGE_DIR"
		libs "vello_bridge" "advapi32" "userenv" "ws2_32" "bcrypt" "ntdll" "kernel32" "shell32" "ole32"
	}
	platform "posix" {
		lflags "-L$VELLO_BRIDGE_DIR"
		libs "vello_bridge" "pthread" "dl" "m"
	}
}

configuration "unittest" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "DewHeadless" "NotoriousTest"
}
