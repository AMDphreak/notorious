name "notorious"
description "Cross-platform sticky notes + notepad hybrid (D + dui/dew)"
authors "amdphreak"
copyright "Copyright © 2026, AMDphreak"
license "BSL-1.0"
version "0.1.1"

dependency "dui" path="../../dlang-supplemental/dui"
dependency "dew" path="../../dlang-supplemental/dew"
dependency "tgc" version="~>0.1.1"

targetType "executable"
targetName "notorious"
mainSourceFile "source/app.d"
sourcePaths "source"
importPaths "source"
stringImportPaths "."

configuration "application" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "DewHeadless"
}

configuration "windowed" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "NotoriousWindowed"
	subConfiguration "dew" "gpu"
	dependency "glfw-d" version="~>1.1.2"
	# Direct dep so vello-d's lflags/libs (vello_bridge staticlib) apply to this exe link.
	dependency "vello-d" path="../../dlang-supplemental/vello-d"
	# Explicit bridge path — transitive $PACKAGE_DIR lflags have not reliably reached the final link.
	platform "windows" {
		lflags "/SUBSYSTEM:WINDOWS"
		lflags "/LIBPATH:../../dlang-supplemental/vello-d/vello_bridge/target/release"
		# Pass the staticlib as a linker input (not only -l) so MSVC actually consumes it.
		lflags "../../dlang-supplemental/vello-d/vello_bridge/target/release/vello_bridge.lib"
		libs "advapi32" "userenv" "ws2_32" "bcrypt" "ntdll" "kernel32" "shell32" "ole32"
	}
	platform "posix" {
		lflags "-L../../dlang-supplemental/vello-d/vello_bridge/target/release"
		lflags "../../dlang-supplemental/vello-d/vello_bridge/target/release/libvello_bridge.a"
		libs "pthread" "dl" "m"
	}
}

configuration "unittest" {
	targetType "executable"
	mainSourceFile "source/app.d"
	versions "DewHeadless" "NotoriousTest"
}
